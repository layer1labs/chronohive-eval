//
// A timed training loop (Trainer) drives storage I/O through two
// single-purpose reactors: CheckpointIO admits periodic checkpoints and
// PrefetchIO issues read-ahead. chronoc lowers this to a .cspec
// specification; the engine executes the specification directly
// (no generated code runs).
//
// The source must pass the real pinned lfc (Python target); chronoc then
// lowers the accepted subset to the specification.

target Python

reactor Trainer(steps=200, ckpt_every=25) {
    output step_done
    output ckpt_request
    state step = 0
    timer tick(0, 1 ms)

    reaction(tick) -> step_done, ckpt_request {=
        train_step()
        step = step + 1
        step_done.set({"step": step})
        if step % ckpt_every == 0:
            ckpt_request.set({"step": step})
        if step >= steps:
            request_stop()
    =}
}

reactor CheckpointIO(mb=64) {
    input ckpt
    reaction(ckpt) {=
        admit_checkpoint(mb=mb)
    =}
}

reactor PrefetchIO(depth=4) {
    input tick
    reaction(tick) {=
        prefetch(depth=depth)
    =}
}

main reactor IoCoordinator(steps=200, ckpt_every=25, ckpt_mb=64, prefetch_depth=4) {
    t = new Trainer(steps=steps, ckpt_every=ckpt_every)
    c = new CheckpointIO(mb=ckpt_mb)
    p = new PrefetchIO(depth=prefetch_depth)
    t.ckpt_request -> c.ckpt
    t.step_done -> p.tick
}
